# Copy this file to .env and fill it in. Git ignores .env.

# Use config.settings.dev locally and config.settings.prod on the servers.
DJANGO_SETTINGS_MODULE=config.settings.dev
# One of dev, test, or prod.
ENV=dev
# Required in prod. Dev and tests fall back to an insecure key when it's empty.
SECRET_KEY=

# Keys for the Clerk application shared by ClinGen's apps.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sentry. Leave SENTRY_DSN empty to turn Sentry off.
SENTRY_DSN=
SENTRY_ENV=

# Database backups. Without a bucket, backups go to backups/ next to src/. On a server,
# use tools or tools-test for SUBDOMAIN; it's part of each backup's name.
DBBACKUP_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SUBDOMAIN=
