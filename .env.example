# Copy this file to .env and fill in the values. Keep the keys in sync with .env;
# `just env-check` reports any differences.

# Clerk authentication keys, from the dashboard of the Clerk application ClinGen's apps
# share.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Django settings: config.settings.dev on your machine, config.settings.prod on a server.
# SECRET_KEY is required on a server; on your machine an insecure default is used.
DJANGO_SETTINGS_MODULE=
ENV=
SECRET_KEY=

# Sentry error monitoring. Leave SENTRY_DSN empty to turn Sentry off.
SENTRY_DSN=
SENTRY_ENV=

# Server-only keys. Leave them empty on your machine. See How to Configure Backup
# Credentials in docs/how-to.md.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DBBACKUP_BUCKET_NAME=
SUBDOMAIN=

# The ETS's AWS access to the GCI and VCI Cognito user pool and DynamoDB table. Leave
# ETS_DRY_RUN empty (on) until a dry run looks right; set it to false to make changes.
ETS_AWS_ACCESS_KEY_ID=
ETS_AWS_SECRET_ACCESS_KEY=
ETS_AWS_REGION=
ETS_COGNITO_USER_POOL_ID=
ETS_DYNAMODB_TABLE_NAME=
ETS_DRY_RUN=
